@{ var f = Model.F; }
<h3>@f.Name</h3>
<p class="mono small">@(f.Path != "" ? f.Path : Model.Share) · level @f.Level</p>
@if (Model.IsNew)
{
  <p class="state pending">New folder (pending). It inherits from its parent; set rights in the matrix before applying if needed.</p>
  <button class="link" @onclick="() => OnCancelNew.InvokeAsync(f.Path)">Cancel this folder</button>
}
else if (Model.Clearing)
{
  <p class="state pending"><b>Clear (pending):</b> this folder goes back to the default. It inherits again and all its own entries are removed, including deny and special entries. Preview to apply it.</p>
}
else if (f.Level > 0)
{
  <p class="state">
    @if (Model.Protected)
    {
      <b>Inheritance broken.</b> <text>Only this folder's own entries apply; rights on parent folders do not reach it.</text>
    }
    else
    {
      <b>Inherits</b> <text>R and W from its parent folders.</text>
    }
    @if (Model.Pending)
    {
      <br><span class="pending-note">Pending change. Preview to apply it.</span>
    }
  </p>
}
@if (Model.CanToggle || Model.CanClear || Model.Clearing)
{
  <div class="choices">
    @if (Model.CanToggle)
    {
      <button class="@(Model.Pending ? "" : "primary")" @onclick="() => OnInheritance.InvokeAsync(Model.Protected)">@(Model.Protected ? "Restore inheritance" : "Break inheritance")</button>
    }
    @if (Model.CanClear || Model.Clearing)
    {
      <button title="Back to the default: inherit everything from the parent folder, no entries of its own" @onclick="() => OnClear.InvokeAsync()">@(Model.Clearing ? "Undo clear" : "Clear")</button>
    }
  </div>
  @if (Model.CanToggle)
  {
    <p class="muted small">@(Model.Protected
      ? "Restore: explicit copies of what the parent passes down are removed; the parent's rights apply again."
      : "Break: the inherited entries are copied as entries of this folder, so nobody loses access. Then remove what should not apply here.")</p>
  }
  @if (Model.CanClear && !Model.Clearing)
  {
    <p class="muted small">Clear: back to the default, like a new folder. It inherits from @(f.Parent is { Length: > 0 } pp ? pp : "(root)") and loses all its own entries. R| that owlseye added on parent folders for these entries is removed as well.</p>
  }
  <p class="muted small">The preview shows every affected user before anything is written.</p>
}
@if (Model.CanAdd && !Model.IsNew)
{
  <h4>New subfolder</h4>
  <form class="newfolder" @onsubmit="Add">
    <input type="text" @bind="name" placeholder="Folder name" required maxlength="@M.MaxFolderName">
    <button type="submit">Add</button>
  </form>
  @foreach (var p in Model.NewHere)
  {
    var path = p;
    <p class="small pending-note">＋ @p (pending)
      <button class="link" @onclick="() => OnCancelNew.InvokeAsync(path)">cancel</button></p>
  }
  <p class="muted small">Creates the folder after preview. It inherits from @f.Name.</p>
}
@if (Model.Grants.Count > 0)
{
  <h4>Groups with access</h4>
  <table class="list small">
    @foreach (var g in Model.Grants)
    {
      <tr><td>@g.Name</td><td><span class="c @Labels.Css(g.Right)">@g.Right</span></td><td class="muted mono">@(g.Source == f.Path ? "here" : "from " + (g.Source is { Length: > 0 } s ? s : "(root)"))</td></tr>
    }
  </table>
}
@if (Model.Hidden.Count > 0)
{
  <h4>Hidden accounts here</h4>
  <table class="list small">
    @foreach (var h in Model.Hidden)
    {
      <tr><td>@h.Name</td><td><span class="c @Labels.Css(h.Right)">@h.Right</span></td><td class="muted">@(h.Inherited ? "inherited" : "here")</td></tr>
    }
  </table>
  <p class="muted small">Not matrix columns; "Hidden accounts" above the matrix shows them.</p>
}
@foreach (var e in Model.IsNew ? [] : Model.OwnerEntries.Where(e => Model.CanSetOwnerEntries || e.Value is not null || e.Inherited is not null))
{
  var co = e.Sid == M.CreatorOwner;
  var entry = e;
  <h4>@(co ? "Creator Owner" : "Owner Rights")</h4>
  <p class="small">@(co ? "Whoever creates a file or folder in here gets on it:" : "The owner of each file and folder in here gets:")
    <b>@Text(e.Sid, e.Value)</b>@(e.Pending ? " (pending)" : "")@if (e.Inherited is { } inh)
    {
      <text>; inherited: </text><b>@Text(e.Sid, inh)</b>
    }</p>
  @if (e.Inherited is not null)
  {
    <p class="muted small">@(f.Level == 0
      ? "The inherited part comes from above the share (often the drive); owlseye does not write there, change it in Explorer."
      : "The inherited part comes from a parent folder: change it there.")</p>
  }
  @if (Model.CanSetOwnerEntries)
  {
    <div class="choices">
      @foreach (var (v, label) in co
        ? new (string?, string)[] { (null, "Nothing"), ("W", "Modify"), ("F", "Full control") }
        : new (string?, string)[] { (null, "Nothing"), ("V", "No personal rights"), ("W", "Modify") })
      {
        var value = v;
        <button class="@(e.Value == value ? "primary" : "")" @onclick="() => OnOwnerEntry.InvokeAsync((entry.Sid, value))">@label</button>
      }
    </div>
    <p class="muted small">@(co
      ? "Applies to everything below, also to what exists already: Windows gives the owner of each file and subfolder the right on it. These are personal rights outside the groups: the matrix does not show them, and they stay when someone leaves a group."
      : "Without an entry, owners may always read and change the permissions of what they own (whoever creates something owns it). With an entry they get only that and cannot change permissions; their access comes from the groups. Applies to everything below.")</p>
  }
}
@if (Model.Findings.Count > 0)
{
  <h4>Findings</h4>
  <ul class="small">
    @foreach (var x in Model.Findings)
    {
      <li><span class="sev @x.Severity">@x.Severity</span> @x.Text</li>
    }
  </ul>
}
@if (!Model.IsNew)
{
  <p class="small"><a href="/folder?path=@Uri.EscapeDataString(f.Path)">Who has access to @f.Name?</a></p>
}

@code {
  [Parameter, EditorRequired] public FolderPanel Model { get; set; } = null!;

  /// <summary>true = restore inheritance, false = break it.</summary>
  [Parameter] public EventCallback<bool> OnInheritance { get; set; }

  [Parameter] public EventCallback OnClear { get; set; }
  /// <summary>Adds the new folder; false if it was refused (the name stays in the field).</summary>
  [Parameter] public Func<string, bool>? TryNewFolder { get; set; }
  [Parameter] public EventCallback<string> OnCancelNew { get; set; }
  /// <summary>An owner entry: (Creator Owner or Owner Rights, a value of M.OwnerEntryValues or null).</summary>
  [Parameter] public EventCallback<(string Sid, string? Value)> OnOwnerEntry { get; set; }

  static string Text(string sid, string? v) => v is null ? "nothing of its own" : Labels.OwnerEntryText(sid, v);

  string name = "";
  string? forPath;

  protected override void OnParametersSet()
  {
    if (forPath != Model.F.Path) name = ""; // each folder gets a fresh form
    forPath = Model.F.Path;
  }

  void Add()
  {
    if (name.Trim() == "" || TryNewFolder is null) return;
    if (TryNewFolder(name)) name = "";
  }
}
