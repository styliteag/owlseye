@page "/preview"
@inherits PageBase

<h1>Preview</h1>
@if (V is null)
{
  return;
}
@if (V.Error is not null)
{
  <div class="flash err">@V.Error</div>
  <a href="/matrix">Back to the matrix</a>
}
else if (V.Plan is null || V.Plan.Empty)
{
  <p class="muted">No changes.</p>
  <a href="/matrix">Back to the matrix</a>
}
else
{
  var plan = V.Plan;
  <div class="cards">
    <div class="card"><b>@plan.AclOps.Count</b>folders (ACLs)</div>
    <div class="card"><b>@V.Cells</b>entries changed</div>
    @if (plan.CreateOps.Count > 0)
    {
      <div class="card"><b>@plan.CreateOps.Count</b>new folders</div>
    }
    <div class="card"><b class="gain">@V.Gained.Count</b>rights gained</div>
    <div class="card"><b class="loss">@V.Lost.Count</b>rights lost</div>
    @if (V.HiddenLosses is { Count: > 0 } hl)
    {
      <div class="card"><b class="loss">@hl.Count</b>entries lose hidden rights</div>
    }
  </div>
  @if (plan.CreateOps.Count > 0)
  {
    <h2>New folders</h2>
    <p>
      @for (var i = 0; i < plan.CreateOps.Count; i++)
      {
        <span class="mono">@plan.CreateOps[i]</span>@(i < plan.CreateOps.Count - 1 ? ", " : "")
      }
    </p>
    <p class="muted small">They inherit from their parent folder. Creating a folder cannot be undone automatically.</p>
  }
  @if (plan.AclOps.SelectMany(o => o.Changes).Any(c => M.IsOwnerSid(c.Sid)))
  {
    <p class="flash"><b>Creator Owner or Owner Rights change.</b> Windows passes this down to the files and subfolders that exist
      already: there the owner of each gets the new right (or loses the old one), and so does whoever creates something new.
      owlseye does not read file owners, so these users are not listed below.</p>
  }
  @if (V.HiddenLosses is { Count: > 0 } losses)
  {
    <div class="flash err">
      <b>These changes remove rights the matrix does not show.</b> The entries below are special entries; the standard entry
      that replaces them grants less, although the cell still shows a right. Check that this is intended.
    </div>
    <table class="list">
      <tr><th>Folder</th><th>Group / account</th><th>now</th><th>after</th><th>removes</th></tr>
      @foreach (var l in losses)
      {
        <tr><td class="mono">@Root(l.Path)</td><td>@l.Name</td><td class="small">@l.Before</td><td class="small">@l.After</td><td class="loss">@l.Lost</td></tr>
      }
    </table>
  }
  <h2>ACL changes</h2>
  <table class="list">
    <tr><th>Folder</th><th>Group / account</th><th>before</th><th>after</th><th></th></tr>
    @foreach (var o in plan.AclOps.Take(MaxOps))
    {
      if (o.Cleared)
      {
        var gone = o.Before.Count(a => !a.Allow);
        <tr><td class="mono">@o.Path</td><td colspan="3"><b>clear</b>: back to the default; inherits from the parent, no entries of its own@(gone > 0 ? $" (also removes {gone} deny entr{(gone == 1 ? "y" : "ies")})" : "")</td><td></td></tr>
      }
      else if (o.ProtectedBefore != o.ProtectedAfter)
      {
        <tr><td class="mono">@Root(o.Path)</td><td colspan="3" class="@(o.ProtectedAfter ? "loss" : "gain")">@(o.ProtectedAfter
          ? "⛔ break inheritance (inherited entries become entries of this folder)"
          : "↳ restore inheritance (explicit copies of inherited entries are removed)")</td><td></td></tr>
      }
      foreach (var c in o.Changes)
      {
        <tr><td class="mono">@Root(o.Path)</td><td>@ShortName(c.Name)</td>
          <td>@Labels.Value(c.Sid, c.Before)</td><td class="@(c.After is not null ? "gain" : "loss")">@Labels.Value(c.Sid, c.After)</td>
          <td>@if (c.Auto) {<span class="sev low">automatic R|</span>}</td></tr>
      }
      var added = Planner.AddedFullControl(o, V.Required ?? []);
      if (added.Count > 0)
      {
        <tr><td class="mono">@Root(o.Path)</td><td>@string.Join(", ", added.Select(a => ShortName(a.Name)))</td><td>–</td><td class="gain">F</td>
          <td><span class="sev low" title="config.json &quot;full_control&quot; (Settings)">full control required</span></td></tr>
      }
    }
  </table>
  @if (plan.AclOps.Count > MaxOps)
  {
    <p class="muted small">The first @MaxOps of @plan.AclOps.Count folders are listed; apply writes all of them.</p>
  }
  <p class="muted small">Only the entries listed change. Entries of other accounts, deny entries and special rights stay as they are; on folders with broken inheritance @(V.Required is { Count: > 0 } req ? string.Join(", ", req.Select(p => ShortName(p.Name))) : "SYSTEM and Administrators") keep (or get) full control (Settings: full control). Windows applies each change to all subfolders; on large trees this can take a while.</p>
  @if (plan.AclOps.SelectMany(o => o.Changes).Any(c => c.After == "F" && c.Before != "F"))
  {
    <p class="flash">F (full control) also lets the members of the group change the folder's permissions and take ownership
      of it. That is usually meant for admin and service groups only.</p>
  }
  <h2>Effect on users</h2>
  @if (plan.Impact.Count > 0)
  {
    var gained = V.Gained.ToHashSet();
    <table class="list">
      <tr><th>Folder</th><th>User</th><th>before</th><th>after</th></tr>
      @foreach (var i in plan.Impact.Take(MaxImpact))
      {
        <tr><td class="mono">@Root(i.Path)</td><td>@i.Display <span class="muted">@i.User</span></td>
          <td>@Labels.Short(i.Before)</td>
          <td class="@(gained.Contains(i) ? "gain" : "loss")">@Labels.Short(i.After)</td></tr>
      }
    </table>
    @if (plan.Impact.Count > MaxImpact)
    {
      <p class="muted small">… and @(plan.Impact.Count - MaxImpact) more (@plan.Impact.Select(i => i.User).Distinct().Count() users,
        @plan.Impact.Select(i => i.Path).Distinct().Count() folders in all; the counts above cover everything).</p>
    }
  }
  else
  {
    <p class="muted">No change for any user, for example because the right is already inherited.</p>
  }
  <form class="applyform" @onsubmit="Apply">
    <input type="text" @bind="reason" placeholder="Reason or ticket (goes into the log)">
    <button type="submit" class="primary" disabled="@Ui.Busy">Apply</button>
    <a href="/matrix">Back</a>
  </form>
  <p class="muted">Before writing, owlseye reads every affected ACL again and stops if it was changed in the meantime.</p>
}

@code {
  // a change on a large share can affect thousands of folders and users: drawing every row would freeze the window
  const int MaxOps = 500, MaxImpact = 200;
  PreviewView? V;
  string reason = "";

  protected override void Refresh()
  {
    if (!Ui.Busy) V = S.Preview(); // while applying, the plan is being emptied: keep showing what is written
  }

  static string ShortName(string name) => name[(name.LastIndexOf('\\') + 1)..];

  Task Apply()
  {
    var phash = V!.Phash;
    var r = reason;
    return Busy(() => S.Apply(r, phash));
  }
}
