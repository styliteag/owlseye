@page "/settings"
@inherits PageBase

<h1>Settings <span class="muted small">owlseye @Version</span></h1>
@if (V is null)
{
  return;
}
<p class="muted">
  Scan, rights and hidden accounts are <b>shared</b>: they are kept in the state folder
  (<span class="mono">@V.SharedFile</span>@(V.SharedExists ? "" : ", not written yet")) and apply to every admin who uses it.
  This computer only remembers where the state folder is:
  @if (V.File is not null)
  {
    <text>read from </text><span class="mono">@V.File</span><text>, </text>
  }
  <text>saved to </text><span class="mono">@V.SaveTo</span>@(V.File is not null && V.SaveTo != V.File ? " (your own copy: the file in use cannot be written; owlseye reads your copy first from the next start)" : "").
  Order at start: --config, then <span class="mono">%LOCALAPPDATA%\owlseye\config.json</span>, then config.json next to owlseye.exe.
</p>
@if (V.Blocked is not null)
{
  <div class="flash err">@V.Blocked</div>
}

<form class="settings" @onsubmit="Save">
  <section>
    <h2>Scan</h2>
    <label>Scan depth <input type="number" min="0" max="100" @bind="scanDepth"></label>
    <p class="muted small">Levels owlseye reads (0 = the whole tree). Below that, owlseye sees neither entries that deviate
      nor changes made outside it. The matrix depth (what is shown) is set in the matrix.</p>
  </section>

  <section>
    <h2>Rights</h2>
    <p>W means:
      <label><input type="radio" name="write" checked="@(write == "modify")" @onchange="@(() => write = "modify")"> Modify (read, write and delete)</label>
      <label><input type="radio" name="write" checked="@(write == "no-delete")" @onchange="@(() => write = "no-delete")"> Read and write, no delete</label>
      <label><input type="radio" name="write" checked="@(write == "keep-folder")" @onchange="@(() => write = "keep-folder")"> Modify inside, the folder itself cannot be deleted, renamed or moved</label>
    </p>
    <p class="muted small">"Modify inside" writes W as two entries: write without delete on the folder itself, Modify on its
      subfolders and files. Users then cannot delete, rename or move a folder through its W entry (a moved folder would take its
      rights along).
      @if (write == "keep-folder" && V.Write != "keep-folder" && V.PlainModify > 0)
      {
        <br><b>@V.PlainModify W entr@(V.PlainModify == 1 ? "y is" : "ies are") the single Modify entry on this share.</b>
        <text> They keep working, and saving writes nothing: the matrix marks them</text> <span class="c W movable">W</span>
        <text> and the Findings page converts them in one go, with a preview.</text>
      }
    </p>
    <label>Accounts that must have full control on the root and on folders with broken inheritance
      <textarea rows="4" @bind="fullControl" placeholder="SYSTEM&#10;Administrators"></textarea></label>
    <AccountPicker OnPick="@(v => fullControl = AddLine(fullControl, v))" />
    <p class="muted small">One per line: SYSTEM, Administrators (the file server's own group), Domain Admins (in any
      language), a SID or a name like CORP\backup. Missing ones are findings, and owlseye adds them when it writes such a
      folder. Empty = SYSTEM and Administrators.
      @if (V.Required.Count > 0)
      {
        <br><text>Found in this share: </text>@string.Join(", ", V.Required.Select(p => $"{p.Name} ({p.Sid})"))
      }
    </p>
    <label>Further accounts to hide (no column, entries left alone)
      <textarea rows="3" @bind="hidden" placeholder="CORP\backup"></textarea></label>
    <AccountPicker OnPick="@(v => hidden = AddLine(hidden, v))" />
    <p class="muted small">One per line, SID or name. SYSTEM, Administrators, Creator Owner, Domain Admins and Enterprise
      Admins are hidden anyway. "Hidden accounts" above the matrix shows them (except Creator Owner) as columns you can set.</p>
  </section>

  <section>
    <h2>State folder</h2>
    <label>Folder for the desired state and the log</label>
    <div class="pathrow">
      <input type="text" @bind="state" placeholder="@V.StateDir">
      <button type="button" @onclick="BrowseState">Browse…</button>
    </div>
    <p class="muted small">Now: log <span class="mono">@V.AuditPath</span>, desired state
      <span class="mono">@(V.BaselineDir ?? "in memory only (demo)")</span>.<br>
      Empty = your profile. For several admins use one folder on an admin share that only admins can write, e.g.
      <span class="mono">\\fileserver\Owlseye$</span>. When you change it, owlseye moves its files there if the folder holds
      none yet; if it already does (another admin uses it), that state is used and nothing is moved. Applies at once.</p>
  </section>

  <div class="applyform">
    <input type="text" @bind="reason" placeholder="Reason (goes into the log)">
    <button type="submit" class="primary" disabled="@(!V.CanSave || Ui.Busy)">Save</button>
  </div>
</form>

@code {
  /// <summary>The version of this exe, e.g. "0.9.18" (without the commit after "+").</summary>
  static readonly string Version = (System.Reflection.CustomAttributeExtensions
      .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(typeof(Settings).Assembly)?.InformationalVersion ?? "?")
      .Split('+')[0];

  SettingsView? V;
  int scanDepth;
  string write = "modify", fullControl = "", hidden = "", state = "", reason = "";
  bool loaded;

  protected override void Refresh()
  {
    V = S.SettingsPage();
    if (loaded) return; // keep what is being edited when the state changes
    loaded = true;
    scanDepth = V.ScanDepth;
    write = V.Write;
    fullControl = string.Join("\n", V.FullControl);
    hidden = string.Join("\n", V.Hidden);
    state = V.State;
  }

  /// <summary>Adds an account as a line of a list, unless it is there already.</summary>
  static string AddLine(string list, string value)
  {
    var lines = list.Split('\n').Select(l => l.Trim()).Where(l => l != "").ToList();
    if (!lines.Contains(value, StringComparer.OrdinalIgnoreCase)) lines.Add(value);
    return string.Join("\n", lines);
  }

  void BrowseState()
  {
    if (Dialogs.PickFolder("State folder for the desired state and the log", state != "" ? state : V?.StateDir) is { } p) state = p;
  }

  Task Save()
  {
    var input = new SettingsInput(scanDepth, write, hidden.Split('\n'), fullControl.Split('\n'), state);
    var r = reason;
    loaded = false; // show what was saved
    return Busy(() => S.SaveSettings(input, r));
  }
}
